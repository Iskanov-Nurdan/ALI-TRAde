# --- Домен и TLS ---
DOMAIN=alitrade.tw1.ru
CERTBOT_EMAIL=admin@alitrade.tw1.ru
# Выпускать сертификат Let's Encrypt (false — работать только по HTTP)
ENABLE_SSL=true
# Переключается автоматически скриптом deploy.sh: http -> https
NGINX_CONF=http
HTTP_PORT=80
HTTPS_PORT=443

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=alitrade.tw1.ru,www.alitrade.tw1.ru,localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Bishkek
LOG_LEVEL=INFO
GUNICORN_WORKERS=3

# --- База данных (Postgres в контейнере) ---
POSTGRES_DB=delivery
POSTGRES_USER=delivery
POSTGRES_PASSWORD=change-me

# --- JWT ---
JWT_ACCESS_HOURS=12
JWT_REFRESH_DAYS=7

# --- CORS / CSRF ---
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://alitrade.tw1.ru,https://www.alitrade.tw1.ru
CSRF_TRUSTED_ORIGINS=https://alitrade.tw1.ru,https://www.alitrade.tw1.ru

# --- Работа за обратным прокси ---
TRUST_PROXY_IP_HEADER=True
NUM_PROXIES=1

# --- Первичное наполнение (команда seed_demo, запускается флагом --seed) ---
ADMIN_PASSWORD=change-me-admin
DEMO_PASSWORD=change-me-employee
